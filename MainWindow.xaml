<Window x:Class="ids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black">

            <TextBlock
                Text="VIDEO AREA"
                Foreground="White"
                FontSize="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        </Border>

        <Border Grid.Row="1"
        Background="#222222">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Text="Orders Ready:"
            Foreground="White"
            FontSize="28"
            FontWeight="Bold"
            VerticalAlignment="Center"
            Margin="15,0,0,0"/>

        <UniformGrid Grid.Column="1"
                     Rows="1"
                     Columns="8">

            <TextBlock Text="A021" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A020" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A019" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A018" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A017" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A016" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A015" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A014" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        </UniformGrid>

    </Grid>

</Border>

    </Grid>

</Window>
