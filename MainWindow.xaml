<Window x:Class="ids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid>
        <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="90" />
        </Grid.RowDefinitions>
       
        <Button x:Name="BtnTestOrder"
            Content="TEST ORDER"
            Width="180"
            Height="60"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="20"
            Panel.ZIndex="1000"
            Click="BtnTestOrder_Click"/>


        <Border Grid.Row="0" Background="Black">

            <TextBlock
                Text="VIDEO AREA"
                Foreground="White"
                FontSize="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        </Border>

        <Border Grid.Row="1"
        Background="#222222">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Text="Orders Ready:"
            Foreground="White"
            FontSize="28"
            FontWeight="Bold"
            VerticalAlignment="Center"
            Margin="15,0,0,0"/>

        <UniformGrid Grid.Column="1"
                     Rows="1"
                     Columns="8">

            <TextBlock Text="A021" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A020" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A019" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A018" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A017" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A016" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A015" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="A014" Foreground="White" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        </UniformGrid>

    </Grid>
    
    </Border>
        <Border x:Name="OrderPopup"
            Background="#99000000"
            Visibility="Collapsed">

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Image x:Name="CompanyLogo"
            Width="250"
            Height="120"
            Margin="0,0,0,20"/>
            <TextBlock Text="ORDER READY"
                    Foreground="White"
                    FontSize="50"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

            <TextBlock x:Name="OrderNumberText"
                    Text="A001"
                    Foreground="White"
                    FontSize="150"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

            <TextBlock x:Name="CounterText"
                    Text="Counter 1"
                    Foreground="White"
                    FontSize="50"
                    HorizontalAlignment="Center"/>

        </StackPanel>

    </Border>
    </Grid>

</Window>
